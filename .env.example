# Copy this file to .env. Keep real credentials out of GitHub.
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.appTimezone = 'Asia/Manila'

database.default.hostname = 127.0.0.1
database.default.database = tasks_db
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.port = 3306

# On hosting, use production, your HTTPS URL, and your host's DB credentials.
# CI_ENVIRONMENT = production
# app.baseURL = 'https://your-domain.example/'
# database.default.DBDebug = false
